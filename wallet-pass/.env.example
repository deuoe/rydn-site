# Copy this file to ".env" and fill in your real values.
#
# IMPORTANT: .env is git-ignored. The real .env never leaves your Mac.

# Password you set when exporting the .p12 file from Keychain Access
PASS_CERT_PASSWORD=YOUR_PASSWORD_HERE

# Your Apple Team Identifier (the 10-character code).
# Find it in App Store Connect → Membership Details → Team ID.
APPLE_TEAM_ID=5HAZ72WN4T
